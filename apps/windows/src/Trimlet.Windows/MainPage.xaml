<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Trimlet_Windows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    IsTabStop="True"
    KeyDown="OnPageKeyDown"
    mc:Ignorable="d">

    <Grid
        AllowDrop="True"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        DragOver="OnDragOver"
        Drop="OnDrop"
        Padding="20"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="OpenButton"
                        x:Uid="OpenButton"
                        Grid.Column="1"
                        Click="OnOpenClicked"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="560" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid MinHeight="260" Background="#FF111318" CornerRadius="12">
                            <MediaPlayerElement
                                x:Name="PlayerElement"
                                AreTransportControlsEnabled="False"
                                HorizontalAlignment="Stretch"
                                Stretch="Uniform"
                                VerticalAlignment="Stretch" />
                            <StackPanel
                                x:Name="EmptyPlayerPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                                <FontIcon FontSize="42" Foreground="White" Glyph="&#xE714;" />
                                <TextBlock
                                    x:Uid="NoMediaTitle"
                                    HorizontalAlignment="Center"
                                    Foreground="White"
                                    FontSize="20"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Uid="DropHint"
                                    HorizontalAlignment="Center"
                                    Foreground="#FFB8BCC6" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="CurrentTimeText"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="00:00:00.000" />
                            <Slider
                                x:Name="TimelineSlider"
                                Grid.Column="1"
                                IsEnabled="False"
                                Maximum="1"
                                StepFrequency="0.01"
                                ValueChanged="OnTimelineValueChanged" />
                            <TextBlock
                                x:Name="DurationText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Text="00:00:00.000" />
                        </Grid>

                        <StackPanel Grid.Row="2" Spacing="4">
                            <Canvas
                                x:Name="RangeTrackCanvas"
                                Height="10"
                                Background="{ThemeResource ControlFillColorDefaultBrush}"
                                SizeChanged="OnRangeTrackSizeChanged">
                                <Border
                                    x:Name="SelectionRangeHighlight"
                                    Height="10"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="5" />
                            </Canvas>
                            <TextBlock
                                x:Name="KeyframeStatusText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12"
                                Text="" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BackFiveButton" x:Uid="BackFiveButton" Click="OnBackFiveClicked" IsEnabled="False" />
                            <Button x:Name="BackTenFrameButton" x:Uid="BackTenFrameButton" Click="OnBackTenFrameClicked" IsEnabled="False" />
                            <Button x:Name="BackFrameButton" x:Uid="BackFrameButton" Click="OnBackFrameClicked" IsEnabled="False" />
                            <Button
                                x:Name="PlayPauseButton"
                                x:Uid="PlayButton"
                                Click="OnPlayPauseClicked"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}"
                                />
                            <Button x:Name="ForwardFrameButton" x:Uid="ForwardFrameButton" Click="OnForwardFrameClicked" IsEnabled="False" />
                            <Button x:Name="ForwardTenFrameButton" x:Uid="ForwardTenFrameButton" Click="OnForwardTenFrameClicked" IsEnabled="False" />
                            <Button x:Name="ForwardFiveButton" x:Uid="ForwardFiveButton" Click="OnForwardFiveClicked" IsEnabled="False" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                            <StackPanel Spacing="6">
                                <TextBlock x:Uid="MediaInfoHeading" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="FileNameText"
                                    x:Uid="NoFileSelected"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MediaDetailsText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    MaxLines="2"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Uid="AudioStreamLabel"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox
                                        x:Name="AudioStreamPicker"
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12">
                            <StackPanel Spacing="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="RangeHeading" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="RangeDurationText"
                                        x:Uid="RangeNotReady"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontFamily="Consolas" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="MarkInButton"
                                        x:Uid="MarkInButton"
                                        Click="OnMarkInClicked"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="MarkOutButton"
                                        x:Uid="MarkOutButton"
                                        Grid.Column="1"
                                        Click="OnMarkOutClicked"
                                        IsEnabled="False" />
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Uid="InLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="InTimeText" FontFamily="Consolas" Text="00:00:00.000" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock x:Uid="OutLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="OutTimeText" FontFamily="Consolas" Text="00:00:00.000" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="GoToInButton" x:Uid="GoToInButton" Click="OnGoToInClicked" IsEnabled="False" />
                                    <Button x:Name="PreviewRangeButton" x:Uid="PreviewRangeButton" Grid.Column="1" Click="OnPreviewRangeClicked" IsEnabled="False" />
                                    <Button x:Name="GoToOutButton" x:Uid="GoToOutButton" Grid.Column="2" Click="OnGoToOutClicked" IsEnabled="False" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <Grid ColumnSpacing="20" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="ExportHeading"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <RadioButton
                                x:Name="FastModeButton"
                                x:Uid="FastModeButton"
                                GroupName="ExportMode"
                                IsChecked="True" />
                            <RadioButton
                                x:Name="AccurateModeButton"
                                x:Uid="AccurateModeButton"
                                GroupName="ExportMode" />
                        </StackPanel>
                        <TextBlock
                            x:Uid="ExportModeHint"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="ExportButton"
                                x:Uid="ExportButton"
                                Click="OnExportClicked"
                                IsEnabled="False"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                        <Grid x:Name="ExportProgressPanel" Grid.Row="1" Grid.ColumnSpan="4" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <ProgressBar x:Name="ExportProgressBar" Minimum="0" Maximum="1" />
                                <TextBlock x:Name="ExportProgressText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="CancelExportButton" x:Uid="CancelExportButton" Grid.Column="1" Click="OnCancelExportClicked" />
                            <Button x:Name="RevealOutputButton" x:Uid="RevealOutputButton" Grid.Column="2" Click="OnRevealOutputClicked" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="StatusBar"
                    Grid.Row="3"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
    </Grid>
</Page>
